# Browserbase (required for env=BROWSERBASE, the default)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# LLM provider key. Either set ANTHROPIC_API_KEY and use "anthropic/..." models,
# OR omit it and use a "gateway/anthropic/..." model to bill the LLM through Browserbase.
ANTHROPIC_API_KEY=

# Optional: override the browser environment. "BROWSERBASE" (default) or "LOCAL".
# LOCAL runs Chromium on your machine and requires: npx playwright install chromium
WAA_ENV=BROWSERBASE

# ── Browser Automation Gateway ──────────────────────────────────────────────
# Port the gateway HTTP server listens on.
PORT=8080

# Optional: require callers to send `authorization: Bearer <token>`.
GATEWAY_TOKEN=

# 1Password (JIT credential resolution). The service-account token is the ONLY
# portal secret the container holds; scope it to the portals vault only.
OP_SERVICE_ACCOUNT_TOKEN=
OP_PORTALS_VAULT=Portals

# Local-testing fallback (used only when OP_SERVICE_ACCOUNT_TOKEN is unset).
# One pair per portalKey, e.g. lightreach:
# PORTAL_LIGHTREACH_USERNAME=
# PORTAL_LIGHTREACH_PASSWORD=
# PORTAL_LIGHTREACH_OTP=
